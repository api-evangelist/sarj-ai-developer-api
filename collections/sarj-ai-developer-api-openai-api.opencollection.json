            "headers": [
              {
                "name": "accept",
                "value": ""
              },
              {
                "name": "x-session-id",
                "value": ""
              }
            ],
            "body": {
              "type": "multipart-form",
              "data": []
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Transcribes an audio file. This endpoint is now a thin wrapper that\ncalls the business logic in the ASR model."
        }
      ]
    }
  ],
  "bundled": true
}