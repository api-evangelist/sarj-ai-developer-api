{
  "opencollection": "1.0.0",
  "info": {
    "name": "Sarj STT Openai API",
    "version": "1.0.2"
  },
  "items": [
    {
      "info": {
        "name": "Openai",
        "type": "folder"
      },
      "items": [
        {
          "info": {
