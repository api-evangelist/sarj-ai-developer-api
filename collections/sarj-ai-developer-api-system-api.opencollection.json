{
  "opencollection": "1.0.0",
  "info": {
    "name": "Sarj.ai Developer System API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "System",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Health Check",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://platform-api.sarj.ai/api/v1/health"
          },
          "docs": "Returns the operational status of the API. Does not require authentication."
        }
      ]
    }
  ],
  "bundled": true
}