          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v1/beta/integrations/token/refresh-all"
          },
          "docs": "Refresh only OAuth tokens; providers without a token refresher count as failures.\n\nReturns:\n    Per-provider and total success/failure counts for the refresh sweep."
